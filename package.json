{
  "name": "firefox-local-bridge",
  "version": "0.2.0",
  "description": "An opt-in Firefox WebExtension and local MCP bridge for AI assistants.",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node server/index.mjs",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "lint:addon": "web-ext lint --source-dir extension --warnings-as-errors",
    "test": "node --test tests/*.test.mjs",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "jsdom": "30.1.3",
    "web-ext": "10.8.0"
  }
}
